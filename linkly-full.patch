diff --git a/lib/stats.ts b/lib/stats.ts
new file mode 100644
index 0000000..5311098
--- /dev/null
+++ b/lib/stats.ts
@@ -0,0 +1,51 @@
+import type { ClickEvent } from "./store";
+
+export interface DayBucket {
+  day: string; // YYYY-MM-DD
+  clicks: number;
+}
+
+export interface ReferrerBucket {
+  referrer: string;
+  clicks: number;
+}
+
+// Group click events into one bucket per calendar day.
+export function clicksPerDay(events: ClickEvent[]): DayBucket[] {
+  const buckets = new Map<string, number>();
+
+  for (const event of events) {
+    const d = new Date(event.ts);
+    const day = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(
+      2,
+      "0"
+    )}-${String(d.getDate()).padStart(2, "0")}`;
+    buckets.set(day, (buckets.get(day) ?? 0) + 1);
+  }
+
+  return [...buckets.entries()]
+    .sort(([a], [b]) => a.localeCompare(b))
+    .map(([day, clicks]) => ({ day, clicks }));
+}
+
+// Count clicks per referring hostname. No referrer header means "direct".
+export function topReferrers(events: ClickEvent[], limit = 5): ReferrerBucket[] {
+  const counts = new Map<string, number>();
+
+  for (const event of events) {
+    let referrer = "direct";
+    if (event.referrer) {
+      try {
+        referrer = new URL(event.referrer).hostname;
+      } catch {
+        referrer = "unknown";
+      }
+    }
+    counts.set(referrer, (counts.get(referrer) ?? 0) + 1);
+  }
+
+  return [...counts.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, limit)
+    .map(([referrer, clicks]) => ({ referrer, clicks }));
+}
diff --git a/lib/store.ts b/lib/store.ts
new file mode 100644
index 0000000..d688a0b
--- /dev/null
+++ b/lib/store.ts
@@ -0,0 +1,49 @@
+import { promises as fs } from "fs";
+import path from "path";
+
+export interface LinkRecord {
+  slug: string;
+  url: string;
+  createdAt: string; // ISO 8601, always UTC
+  clicks: number;
+}
+
+export interface ClickEvent {
+  slug: string;
+  ts: string; // ISO 8601, always UTC
+  referrer: string | null;
+}
+
+export interface Db {
+  links: Record<string, LinkRecord>;
+  events: ClickEvent[];
+}
+
+const DB_PATH = path.join(process.cwd(), "data", "db.json");
+
+// Read the whole database file. If it doesn't exist yet we start empty.
+export async function readDb(): Promise<Db> {
+  try {
+    const raw = await fs.readFile(DB_PATH, "utf8");
+    const db = JSON.parse(raw) as Db;
+    // A null-prototype map, so a slug like "constructor" is just a normal key.
+    db.links = Object.assign(Object.create(null), db.links);
+    return db;
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code === "ENOENT") {
+      return { links: Object.create(null), events: [] };
+    }
+    throw err;
+  }
+}
+
+// Write the whole database file. We write to a temp file and rename it so a
+// reader never sees a half-written file.
+export async function writeDb(db: Db): Promise<void> {
+  await fs.mkdir(path.dirname(DB_PATH), { recursive: true });
+  const tmp = `${DB_PATH}.${process.pid}.${Date.now()}.${Math.random()
+    .toString(36)
+    .slice(2)}.tmp`;
+  await fs.writeFile(tmp, JSON.stringify(db, null, 2), "utf8");
+  await fs.rename(tmp, DB_PATH);
+}
